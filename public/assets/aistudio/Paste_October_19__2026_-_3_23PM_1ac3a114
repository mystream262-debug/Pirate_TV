/* ---------- comprobar un enlace (sin programas externos) ----------
   Abre el enlace, espera a que lleguen los primeros bytes y lo cierra enseguida.
   Devuelve: "ok" | "hard" (404/410) | "soft" (sin datos, timeout, error) | "unk" (servidor limita/rechaza) */
function checkUrl(url, ms, cb){
  var x = null, fin = false, tm = null;
  function end(r){
    if(fin) return; fin = true;
    try{ clearTimeout(tm); }catch(e){}
    try{ x.onreadystatechange = function(){}; x.onprogress = null; }catch(e){}
    try{ x.abort(); }catch(e){}
    cb(r);
  }
  function look(){
    if(fin) return;
    var rs = x.readyState, s = 0, t = "";
    if(rs < 2) return;
    try{ s = x.status; }catch(e){ s = 0; }
    if(s == 401 || s == 403 || s == 429 || s == 458 || s == 509) return end("unk");
    if(s == 404 || s == 410) return end("hard");
    if(s >= 400) return end("soft");
    if(s == 0){ if(rs == 4) end("soft"); return; }
    if(rs >= 3){
      try{ t = x.responseText; }catch(e){ return end("ok"); }
      if(t && t.length){ return end(t.charAt(0) == "<" ? "soft" : "ok"); }
      if(rs == 4) return end("soft");
    }
  }
  try{
    x = new XMLHttpRequest();
    x.open("GET", url, true);
    try{ x.setRequestHeader("Cache-Control", "no-cache"); }catch(e){}
    x.onreadystatechange = look;
    try{ x.onprogress = look; }catch(e){}
    tm = setTimeout(function(){ end("soft"); }, ms);
    x.send();
  }catch(e){
    fin = true; try{ clearTimeout(tm); }catch(e2){}
    setTimeout(function(){ cb("soft"); }, 0);
  }
}

/* un enlace, con reintentos si el servidor dice "demasiadas conexiones" (y baja la velocidad solo) */
function dpCheck(it, P, tmo, cb){
  var tries = 0;
  (function go(){
    checkUrl(it.url, tmo, function(r){
      if(r == "unk"){
        tries++;
        if(P && P.n > 1) P.n--;
        if(tries < 3 && DP && !DP.stop){ setTimeout(go, 2000); return; }
      }
      cb(r);
    });
  })();
}

/* ---------- DEPURAR ---------- */
function openDep(){
  if(!base){ st("Primero conecta tu servidor en Ajustes."); return; }
  if(!(DP && DP.running)){
    if(tmode() == "series"){ st("Depurar funciona en TV en vivo y Pel\u00edculas: elige ese tipo en la lista."); return; }
    $("dpTitle").innerText = "Depurar \u2013 " + modeLabel(tmode());
    var n = deadCount(tmode());
    $("dpMsg").innerHTML = "Cuando termine, los enlaces ca\u00eddos dejan de verse y tampoco saldr\u00e1n al exportar." +
      (n ? "<br>Ya hay <b>" + n + "</b> quitados en esta pesta\u00f1a." : "") +
      (maxCons ? "<br>Tu cuenta permite <b>" + maxCons + "</b> conexi\u00f3n(es): si el servidor rechaza, el programa baja la velocidad solo. Cierra el reproductor mientras depuras." : "");
    $("dpBar").style.width = "0%"; $("dpDone").innerText = "0 / 0"; $("dpOk").innerText = "0"; $("dpBad").innerText = "0"; $("dpUnk").innerText = "0"; $("dpSpd").innerText = "-";
  }
  $("dep").style.display = "block";
}
function closeDep(){ $("dep").style.display = "none"; }
function dpMsg(h){ $("dpMsg").innerHTML = h; }
function dpUpdate(force){
  if(!DP) return;
  var n = new Date().getTime();
  if(!force && n - DP.ui < 250) return;
  DP.ui = n;
  var S = DP.stat, ph2 = (DP.ph == 2), d = ph2 ? DP.p2d : S.done, t = ph2 ? DP.p2t : S.total;
  var el = (n - DP.t0) / 1000, spd = el > 0 ? (S.done + DP.p2d) / el : 0;
  $("dpBar").style.width = (t ? Math.round(d * 100 / t) : 0) + "%";
  $("dpDone").innerText = d + " / " + t + (ph2 ? " (2.\u00aa revisi\u00f3n)" : "");
  $("dpOk").innerText = S.ok; $("dpBad").innerText = S.dead; $("dpUnk").innerText = S.unk;
  $("dpSpd").innerText = spd.toFixed(1) + " enlaces/s" + ((spd > 0 && t > d) ? "  \u00b7  faltan ~" + fmt((t - d) / spd) : "");
  st("Depurando " + modeLabel(DP.mode) + ": " + d + " / " + t + "  |  ca\u00eddos: " + S.dead);
}
function startDep(){
  if(toolBusy){ st("Hay otra operaci\u00f3n en curso."); return; }
  if(!base || tmode() == "series") return;
  var m = tmode(), conc = parseInt($("dpConc").value, 10) || 6, tmo = (parseInt($("dpTmo").value, 10) || 6) * 1000, again = $("dpAgain").checked;
  toolBusy = true;
  DP = { mode:m, running:true, stop:false, pool:null, ph:1, p2d:0, p2t:0, ui:0, t0:new Date().getTime(), stat:{ total:0, done:0, ok:0, dead:0, unk:0 }, guard:false };
  $("dpStart").disabled = true; $("dpStop").disabled = false; $("dpRestore").disabled = true;
  $("dpTitle").innerText = "Depurar \u2013 " + modeLabel(m);
  dpMsg("Descargando la lista completa...");
  loadFull(m, function(items){
    if(!items || !items.length){ endDep([], "No se pudo obtener la lista (o est\u00e1 vac\u00eda)."); return; }
    var S = DP.stat, hard = [], soft = [];
    S.total = items.length; DP.t0 = new Date().getTime();
    dpMsg("Revisando " + items.length + " enlaces (" + conc + " a la vez)...");
    DP.pool = runPool(items, conc, function(it, next){
      dpCheck(it, DP.pool, tmo, function(r){
        S.done++;
        if(r == "ok") S.ok++;
        else if(r == "hard"){ S.dead++; hard.push(it.id); }
        else if(r == "soft"){ S.dead++; soft.push(it); }
        else S.unk++;
        if(S.unk >= 15 && S.ok == 0 && S.dead == 0){ DP.guard = true; DP.stop = true; DP.pool.stop = true; }
        dpUpdate(false); next();
      });
    }, function(){}, function(){
      dpUpdate(true);
      if(DP.guard){ endDep([], "El servidor est\u00e1 rechazando las conexiones (l\u00edmite de la cuenta o cuenta bloqueada). No se quit\u00f3 nada."); return; }
      if(!again || DP.stop || !soft.length){
        /* sin 2.a vuelta: los "soft" tambien se quitan, salvo que hayas detenido antes de confirmar */
        endDep(hard.concat((DP.stop && again) ? [] : idsOf(soft)), DP.stop ? "Detenido." : "");
        return;
      }
      DP.ph = 2; DP.p2d = 0; DP.p2t = soft.length;
      dpMsg("Confirmando " + soft.length + " enlaces que no respondieron...");
      var back = {};
      DP.pool = runPool(soft, Math.min(conc, 4), function(it, next){
        dpCheck(it, DP.pool, tmo, function(r){
          DP.p2d++;
          if(r == "ok"){ S.dead--; S.ok++; back[it.id] = 1; }
          else if(r == "unk"){ S.dead--; S.unk++; back[it.id] = 1; }
          dpUpdate(false); next();
        });
      }, function(){}, function(){
        dpUpdate(true);
        var kill = hard.slice(), i;
        if(!DP.stop){ for(i=0;i<soft.length;i++){ if(!back[soft[i].id]) kill.push(soft[i].id); } }
        endDep(kill, DP.stop ? "Detenido durante la confirmaci\u00f3n: solo se quitaron los que dieron error definitivo." : "");
      });
    });
  });
}
function idsOf(list){ var o = [], i; for(i=0;i<list.length;i++) o.push(list[i].id); return o; }
function stopDep(){
  if(!DP || !DP.running) return;
  DP.stop = true; if(DP.pool) DP.pool.stop = true;
  $("dpStop").disabled = true; dpMsg("Deteniendo... esperando a que terminen los enlaces en curso.");
}
function endDep(kill, note){
  var S = DP.stat, m = DP.mode, msg = note || "", i;
  var judged = S.ok + S.dead;
  if(kill.length && judged >= 20 && S.ok == 0){
    msg = "Casi todos los enlaces fallaron: parece un problema de conexi\u00f3n o de l\u00edmite del servidor. No se quit\u00f3 nada.";
    kill = [];
  } else if(kill.length){
    var d = dead[ns] || (dead[ns] = {}), mm = d[m] || (d[m] = {});
    for(i=0;i<kill.length;i++) mm[kill[i]] = 1;
    saveDead();
    msg = "Listo. Se quitaron <b>" + kill.length + "</b> enlaces ca\u00eddos de " + modeLabel(m) + ". " + msg;
  } else if(!msg){
    msg = "Listo. Todos los enlaces revisados respondieron.";
  }
  if(S.unk) msg += "<br>" + S.unk + " no se pudieron verificar (el servidor los rechaz\u00f3) y se dejaron en la lista.";
  DP.running = false; toolBusy = false;
  $("dpStart").disabled = false; $("dpStop").disabled = true; $("dpRestore").disabled = false;
  dpMsg(msg);
  st("Depurar terminado: " + kill.length + " quitados, " + S.ok + " en l\u00ednea.");
  if(kill.length && scr == "sec" && mode == m){ selCat(curCat); }
}
function restoreDep(){
  if(toolBusy) return;
  var n = deadCount(tmode());
  if(!n){ dpMsg("No hay enlaces quitados en esta pesta\u00f1a."); return; }
  if(!confirm("Se volver\u00e1n a mostrar los " + n + " enlaces quitados de " + modeLabel(tmode()) + ".\n\n\u00bfContinuar?")) return;
  if(dead[ns]) delete dead[ns][tmode()];
  saveDead();
  dpMsg("Restaurados " + n + " enlaces.");
  if(scr == "sec" && mode == tmode()) selCat(curCat);
}

document.onkeydown = function(e){
  e = e || window.event;
  if(e.keyCode == 27){
    if(INTRO) INTRO();
    else if($("pw").style.display == "block") closePw();
    else if($("dep").style.display == "block") closeDep();
    else if($("cfg").style.display == "block") closeCfg();
    else if($("modal").style.display == "block") closeDetail();
    else if(scr == "search") clearSearch();
    else closeSide();
  }
};
window.onunload = function(){ try{ stopHere(); endSession(true); saveProg(true); }catch(e){} };

window.onload = function(){
  try{ window.resizeTo(1320, 800); }catch(e){}
  $("lLogo").src = IMG.logo; $("bLogo").src = IMG.logoS;
  $("tLive").src = IMG.live; $("tVod").src = IMG.vod; $("tSeries").src = IMG.series;
  loadAll(); dragInit();
  $("l_usr").value = cfg.usr || ""; $("l_pwd").value = cfg.pwd || "";
  setScr("login");
  try{ ($("l_usr").value ? $("l_pwd") : $("l_usr")).focus(); }catch(e){}
};
</script>
