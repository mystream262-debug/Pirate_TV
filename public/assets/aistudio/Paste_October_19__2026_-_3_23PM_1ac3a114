function isDead(m, sid){ var d = dead[ns]; return !!(d && d[m] && d[m][sid]); }
function deadCount(m){ var d = dead[ns], n = 0, k; if(d && d[m]){ for(k in d[m]){ if(d[m].hasOwnProperty(k)) n++; } } return n; }
function modeLabel(m){ return m == "live" ? "TV en vivo" : (m == "vod" ? "Pel\u00edculas" : "Series"); }
