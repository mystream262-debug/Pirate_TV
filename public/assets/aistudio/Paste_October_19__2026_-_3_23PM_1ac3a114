/* ---------- buscador global ---------- */
function onSearchKey(e){
  var k = e ? e.keyCode : 0;
  if(k == 27){ clearSearch(); return; }
  clearTimeout(sTmr);
  sTmr = setTimeout(function(){ runSearch(false); }, (k == 13) ? 0 : 250);
}
function clearSearch(){ clearTimeout(sTmr); $("q").value = ""; leaveSearch(); }
function leaveSearch(){ if(scr != "search") return; $("q").value = ""; setScr(prevScr == "sec" ? "sec" : "home"); }
function needIdx(m){
  if(IDXST[m] == 2 || IDXST[m] == 3 || SWAIT[m]) return;
  SWAIT[m] = 1;
  loadIndex(m, function(ok){ SWAIT[m] = 0; if(ok && scr == "search") runSearch(true); });
}
function retryIdx(m){ IDXST[m] = 0; needIdx(m); renderSearch(true); }
function runSearch(keep){
  var tk = tokens($("q").value), i, j, k, m, src, it, ok, out;
  if(!tk.length){ if(scr == "search") leaveSearch(); return; }
  if(scr == "login") return;
  if(scr != "search"){ prevScr = scr; setScr("search"); }
  SQ = $("q").value.replace(/^\s+|\s+$/g, "");
  for(i=0;i<3;i++){
    m = MODES[i]; out = [];
    if(IDXST[m] == 2){
      src = IDX[m];
      for(j=0;j<src.length;j++){
        it = src[j]; ok = true;
        for(k=0;k<tk.length;k++){ if(it.nl.indexOf(tk[k]) < 0){ ok = false; break; } }
        if(!ok) continue;
        if(m != "series" && isDead(m, it.sid)) continue;
        out.push(it);
      }
    } else needIdx(m);
    SR[m] = out;
    if(!keep) SSHOW[m] = 48;
  }
  renderSearch(!!keep);
}
function setSF(f){ SF = f; renderSearch(false); }
function moreRes(m){ SSHOW[m] += 60; renderSearch(true); }
function clickRes(m, i){
  var it = SR[m][i]; if(!it) return;
  if(m == "live") playLive(it); else openDetail(it, m);
}
function renderSearch(keep){
  var el = $("sres"), top = keep ? el.scrollTop : 0, h = [], i, j, m, n, tot = 0, ready = 0, shown, stt, lab;
  for(i=0;i<3;i++){ tot += SR[MODES[i]].length; if(IDXST[MODES[i]] == 2) ready++; }
  function chip(f, label, cnt){
    return '<span class="sch' + (SF == f ? ' on' : '') + '" onclick="setSF(\'' + f + '\')">' + label + '<span class="n">' + cnt + '</span></span>';
  }
  function cntOf(m){ return IDXST[m] == 2 ? SR[m].length : "..."; }
  h.push('<div class="srT">Resultados para <b>&ldquo;' + esc(SQ) + '&rdquo;</b></div>');
  h.push('<div class="schips">' + chip("all", "Todo", ready == 3 ? tot : (tot + "+")) + chip("live", "TV en vivo", cntOf("live")) +
         chip("vod", "Pel&iacute;culas", cntOf("vod")) + chip("series", "Series", cntOf("series")) + '</div>');
  for(i=0;i<3;i++){
    m = MODES[i];
    if(SF != "all" && SF != m) continue;
    n = SR[m].length; stt = IDXST[m]; lab = modeLabel(m);
    if(SF == "all" && stt == 2 && !n) continue;
    h.push('<div class="secT">' + esc(lab) + ' <span class="cnt">' + (stt == 2 ? n : "...") + '</span></div>');
    if(stt == 0 || stt == 1){ h.push('<div class="msg">Cargando ' + esc(lab.toLowerCase()) + '... los resultados aparecer&aacute;n solos.</div>'); continue; }
    if(stt == 3){ h.push('<div class="msg">No se pudo cargar. <button class="btng sm" onclick="retryIdx(\'' + m + '\')">Reintentar</button></div>'); continue; }
    if(!n){ h.push('<div class="msg">Sin resultados en ' + esc(lab.toLowerCase()) + '.</div>'); continue; }
    shown = Math.min(n, SSHOW[m]);
    h.push('<div class="grid">');
    for(j=0;j<shown;j++) h.push(cardHtml(SR[m][j], m, "clickRes('" + m + "'," + j + ")", true));
    h.push('</div>');
    if(shown < n) h.push('<button class="more" onclick="moreRes(\'' + m + '\')">Mostrar m\u00e1s (' + (n - shown) + ' restantes)</button>');
  }
  if(ready == 3 && !tot) h.push('<div class="msg">No encontr\u00e9 nada con esa b\u00fasqueda.</div>');
  el.innerHTML = h.join("");
  el.scrollTop = top;
  st(ready == 3 ? (tot + " resultados") : "Buscando... (a\u00fan cargando algunas listas)");
}

/* ---------- arrastrar con el mouse como si fuera touch ---------- */
var DR = { on:false, v:null, h:null, x:0, y:0, sx:0, sy:0, moved:false, cancel:false };
function dragInit(){
  var VID = { content:1, sres:1, side:1, mbox:1, cfgbox:1 };
  document.addEventListener("mousedown", function(e){
    if(e.button != 0) return;
    var t = e.target, tag = String(t.tagName || "").toUpperCase(), v = null, h = null, n = t;
    if(tag == "INPUT" || tag == "SELECT" || tag == "TEXTAREA" || tag == "VIDEO" || tag == "OPTION") return;
    while(n && n.nodeType == 1){
      if(!h && /(^|\s)crow(\s|$)/.test(n.className || "")) h = n;
      if(!v && n.id && VID[n.id]){ v = n; break; }
      n = n.parentNode;
    }
    if(!v && !h) return;
    DR.on = true; DR.v = v; DR.h = h; DR.x = e.clientX; DR.y = e.clientY;
    DR.sx = h ? h.scrollLeft : 0; DR.sy = v ? v.scrollTop : 0; DR.moved = false;
  }, false);
  document.addEventListener("mousemove", function(e){
    if(!DR.on) return;
    var dx = e.clientX - DR.x, dy = e.clientY - DR.y;
    if(!DR.moved && Math.abs(dx) + Math.abs(dy) < 8) return;
