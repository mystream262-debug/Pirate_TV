/* ---------- indice global (todo el contenido en memoria) ---------- */
function flushW(m, ok){ var w = IDXW[m], i; IDXW[m] = []; for(i=0;i<w.length;i++){ try{ w[i](ok); }catch(e){} } }
function byRating(a, b){ return (b.rating - a.rating) || (b.added - a.added); }
function buildIndex(m, d){
  var arr = [], cnt = {}, i, o, it, b;
  if(d instanceof Array){
    for(i=0;i<d.length;i++){
      o = d[i];
      if(m == "series"){
        b = o.backdrop_path;
        it = { m:m, name:o.name, sid:o.series_id, img:V(o.cover), rating:parseFloat(o.rating)||0, added:parseInt(o.last_modified,10)||0,
               plot:V(o.plot).substring(0,300), bg:(b instanceof Array) ? (b[0] || "") : V(b), cid:String(o.category_id) };
      } else {
        it = { m:m, name:o.name, sid:o.stream_id, img:V(o.stream_icon), rating:parseFloat(o.rating)||0, added:parseInt(o.added,10)||0,
               ext:V(o.container_extension), cid:String(o.category_id) };
      }
      it.nl = keyOf(it.name);
      cnt[it.cid] = (cnt[it.cid] || 0) + 1;
      arr.push(it);
    }
  }
  if(m != "live") arr.sort(byRating);      /* mejor calificadas primero */
  IDX[m] = arr; CATCNT[m] = cnt;
}
function loadIndex(m, cb){
  if(IDXST[m] == 2){ if(cb) cb(true); return; }
  if(IDXST[m] == 3) IDXST[m] = 0;
  if(cb) IDXW[m].push(cb);
  if(IDXST[m] == 1) return;
  IDXST[m] = 1;
  var tk = loginTok;
  st("Cargando " + modeLabel(m).toLowerCase() + "...");
  catNames(m, function(cm){
    if(tk != loginTok) return;
    CATN[m] = cm;
    apiTry(A[m].list, "", function(d){
      if(tk != loginTok) return;
      buildIndex(m, d); IDXST[m] = 2;
      st(modeLabel(m) + ": " + IDX[m].length + " t\u00edtulos listos para buscar");
      flushW(m, true);
    }, function(msg){
      if(tk != loginTok) return;
      IDXST[m] = 3; st("No se pudo cargar " + modeLabel(m).toLowerCase() + " (" + msg + ")"); flushW(m, false);
    });
  });
}
function prefetch(){
  var q = ["vod", "series", "live"], tk = loginTok;
  (function next(){
    if(tk != loginTok || !q.length) return;
    var m = q.shift();
    loadIndex(m, function(){ next(); });
  })();
}

/* ---------- secciones ---------- */
