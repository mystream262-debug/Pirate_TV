}

/* ---------- limpieza de nombre + IMDb ---------- */
function cleanTitle(n){
  var s = String(n||""), year = null, m;
  m = s.match(/[\(\[]\s*((?:19|20)\d{2})\s*[\)\]]/);
  if(m) year = parseInt(m[1],10);
  s = s.replace(/^\s*[A-Z]{2,4}\s*\|\s*/, "").replace(/^\s*[A-Z]{2,4}\s+-\s+/, "");
  s = s.replace(/\[[^\]]*\]/g, " ").replace(/\([^\)]*\)/g, " ");
  s = s.replace(/\b(4K|UHD|FHD|FULLHD|HD|SD|1080P|720P|2160P|HEVC|H265|X265|LATINO|CASTELLANO|ESPA.OL|DUAL|MULTI|SUBTITULADO|SUBS?|VOSE|VOS)\b/gi, " ");
  s = s.replace(/[\|_]+/g, " ");
  m = s.match(/^(.*\S)[\s\-:]+((?:19|20)\d{2})\s*$/);
  if(m){ if(!year) year = parseInt(m[2],10); s = m[1]; }
  s = s.replace(/\s{2,}/g, " ").replace(/^[\s\-:]+|[\s\-:]+$/g, "");
  return { title:s, year:year };
}
function norm(s){ return String(s||"").toLowerCase().replace(/[^a-z0-9]/g, ""); }
function pickImdb(list, c, md){
  var best = null, bs = -99, nt = norm(c.title);
  for(var i=0;i<list.length;i++){
    var r = list[i];
    if(!r.id || r.id.indexOf("tt") !== 0) continue;
    var q = String(r.q||"").toLowerCase();
    if(q.indexOf("video game") > -1) continue;
    var isS = (q.indexOf("tv series") > -1 || q.indexOf("tv mini") > -1);
    var sc = Math.max(0, 3 - i), nl = norm(r.l);
    if(nl == nt) sc += 10; else if(nl && nt && (nl.indexOf(nt) > -1 || nt.indexOf(nl) > -1)) sc += 4;
    if(c.year && r.y){ var dy = Math.abs(c.year - r.y); if(dy == 0) sc += 6; else if(dy == 1) sc += 3; else sc -= 2; }
    if((md == "series") == isS) sc += 5;
    if(sc > bs){ bs = sc; best = r; }
  }
  return bs >= 5 ? best : null;
}
function decodeEnt(s){
  return String(s||"").replace(/&quot;/g,'"').replace(/&#39;|&#x27;|&apos;/g,"'").replace(/&amp;/g,"&").replace(/&lt;/g,"<").replace(/&gt;/g,">");
}
function fetchImdbDetails(rec, done){
  if(cfg.omdb){
    http("https://www.omdbapi.com/?i=" + rec.id + "&plot=full&apikey=" + encodeURIComponent(cfg.omdb), function(t){
      try{
        var o = JSON.parse(t);
        if(o.Response == "True"){
          rec.plot = V(o.Plot); rec.rating = V(o.imdbRating); rec.votes = V(o.imdbVotes);
          rec.genre = V(o.Genre); rec.runtime = V(o.Runtime); rec.director = V(o.Director);
          rec.actors = V(o.Actors); rec.rated = V(o.Rated); rec.awards = V(o.Awards);
          rec.rt = ""; rec.rtc = 1;
          if(o.Ratings && o.Ratings.length){
            for(var ri=0; ri<o.Ratings.length; ri++){ if(o.Ratings[ri].Source == "Rotten Tomatoes"){ rec.rt = V(o.Ratings[ri].Value); break; } }
          }
          if(!rec.img) rec.img = V(o.Poster);
        } else { rec.omdbErr = V(o.Error) || "Respuesta no v\u00e1lida de OMDb"; }
      }catch(e){}
      done();
    }, function(){ rec.omdbErr = "No se pudo conectar con OMDb"; done(); });
  } else {
    http("https://www.imdb.com/title/" + rec.id + "/", function(t){
      try{
        var m = t.match(/"description":"((?:[^"\\]|\\.)*)"/);
        if(m) rec.plot = decodeEnt(JSON.parse('"' + m[1] + '"'));
        var r = t.match(/"ratingValue":\s*([0-9.]+)/);
        if(r) rec.rating = r[1];
      }catch(e){}
      done();
    }, function(){ done(); });
  }
}
function lookupImdb(t, custom){
  var c = D.clean, title = custom || c.title;
  var key = D.mode + "|" + title.toLowerCase() + "|" + (custom ? "" : (c.year || ""));
  var hit = imdbCache[key];
  if(hit && hit.id && (hit.plot || !cfg.omdb)){
    D.imdb = hit; D.imdbState = "done"; renderDetail();
    if(cfg.omdb && !hit.rtc){
      delete hit.omdbErr;
      fetchImdbDetails(hit, function(){ saveCache(); if(D && D.tok == t){ D.imdb = hit; renderDetail(); } });
    }
    return;
  }
  var q = title.toLowerCase();
  if(!q){ D.imdbState = "none"; renderDetail(); return; }
  var ch = q.charAt(0); if(!/[a-z0-9]/.test(ch)) ch = "x";
  http("https://v2.sg.media-imdb.com/suggestion/" + ch + "/" + encodeURIComponent(q) + ".json", function(txt){
    if(!D || D.tok != t) return;
    var r = null; try{ r = JSON.parse(txt); }catch(e){}
    var cc = custom ? { title:title, year:null } : c;
    var m = (r && r.d) ? pickImdb(r.d, cc, D.mode) : null;
    if(!m){ D.imdbState = "none"; renderDetail(); return; }
    var rec = { id:m.id, title:m.l, year:m.y, img:(m.i && m.i.imageUrl) || "", cast:m.s || "", type:m.q || "" };
    fetchImdbDetails(rec, function(){
      imdbCache[key] = rec; saveCache();
      if(D && D.tok == t){ D.imdb = rec; D.imdbState = "done"; renderDetail(); }
    });
  }, function(){ if(D && D.tok == t){ D.imdbState = "error"; renderDetail(); } });
}
function reSearch(){
  var v = $("reQ").value.replace(/^\s+|\s+$/g, "");
  if(!v || !D) return;
  D.imdb = null; D.imdbState = "loading"; D.plotEs = null; D.showEs = false;
  renderDetail();
  lookupImdb(D.tok, v);
}
function trPlot(){
  if(!D || !D.imdb || !D.imdb.plot) return;
  if(D.plotEs){ D.showEs = !D.showEs; renderDetail(); return; }
  st("Traduciendo...");
  var t = D.tok;
  http("https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=es&dt=t&q=" + encodeURIComponent(D.imdb.plot), function(txt){
    if(!D || D.tok != t) return;
    try{
      var r = JSON.parse(txt), out = "";
      for(var i=0;i<r[0].length;i++) out += r[0][i][0];
      D.plotEs = out; D.showEs = true; st("Traducido."); renderDetail();
