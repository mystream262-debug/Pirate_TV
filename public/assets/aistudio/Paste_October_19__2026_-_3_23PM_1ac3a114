function cardHtml(it, m, click, showCat){
  var lv = (m == "live"), extra = "", pc = 0, p, l, rt, cat = "";
  if(!lv && it.rating > 0) extra += '<div class="bd">&#9733; ' + it.rating.toFixed(1) + '</div>';
