    else st("Abierto: " + name + ". Este reproductor no permite guardar el progreso solo; usa \"Marcar como vista\".");
  }
}
function beginSession(ctx, port, pw){
  endSession(true);
  sess = { ctx:ctx, port:port, pw:pw, started:new Date().getTime(), seen:false, fails:0, busy:false, lastT:0, lastD:0 };
  sess.timer = setInterval(pollVlc, 4000);
}
function pollVlc(){
  var s = sess; if(!s || s.busy) return;
  s.busy = true;
  var x = new XMLHttpRequest();
  x.open("GET", "http://127.0.0.1:" + s.port + "/requests/status.json?_=" + new Date().getTime(), true);
  try{ x.timeout = 3000; }catch(e){}
  try{ x.setRequestHeader("Authorization", "Basic " + btoa(":" + s.pw)); }catch(e){}
  x.onreadystatechange = function(){
    if(x.readyState != 4) return;
    s.busy = false;
    if(sess !== s) return;
    if(x.status == 200){
      var o; try{ o = JSON.parse(x.responseText); }catch(e){ return; }
      s.seen = true; s.fails = 0;
      var t = parseFloat(o.time) || 0, d = parseFloat(o.length) || 0;
      if(t > 0){ s.lastT = t; if(d > 0) s.lastD = d; recordProg(s.ctx, t, d || s.lastD); }
    } else {
      s.fails++;
      if((s.seen && s.fails >= 2) || (!s.seen && new Date().getTime() - s.started > 60000)){
        if(!s.seen) st("No pude conectar con VLC para guardar el progreso. Usa \"Marcar como vista\".");
        endSession(false);
      }
    }
  };
  try{ x.send(); }catch(e){ s.busy = false; s.fails++; }
}
function endSession(silent){
  if(!sess) return;
  var s = sess; sess = null;
  try{ clearInterval(s.timer); }catch(e){}
  if(s.lastD > 0 && s.lastT >= s.lastD * 0.9) recordProg(s.ctx, s.lastD, s.lastD);
  saveProg(true);
  if(!silent){ renderCont(); if(D) renderDetail(); st("Progreso guardado."); }
}

/* reproductor integrado */
function playHere(url, name, ctx){
  var v = $("v");
  hereCtx = ctx || null; hereT = 0;
  $("vbox").style.display = "block";
  v.onerror = function(){ st("Formato no compatible con el reproductor integrado. Usa VLC."); };
  v.onloadedmetadata = function(){
    var r = (hereCtx && !hereCtx.noResume) ? resumeSecs(hereCtx.key) : 0;
    if(r > 0){ try{ v.currentTime = r; }catch(e){} }
  };
  v.ontimeupdate = function(){
    if(!hereCtx || !(v.currentTime > 0)) return;
    var n = new Date().getTime();
    if(n - hereT > 5000){ hereT = n; recordProg(hereCtx, v.currentTime, v.duration); }
  };
  v.onpause = function(){ if(hereCtx && v.currentTime > 0){ recordProg(hereCtx, v.currentTime, v.duration); saveProg(true); } };
  v.onended = function(){ if(hereCtx && v.duration > 0){ recordProg(hereCtx, v.duration, v.duration); saveProg(true); } };
  if(hereCtx) touchLast(hereCtx);
  killHls();
  if(/\.m3u8(\?|$)/i.test(url)){ startHls(v, url); }
  else { v.src = url; try{ v.load(); v.play(); }catch(e){} }
  $("mbox").scrollTop = 0;
  if(!/\.m3u8(\?|$)/i.test(url)) st("Reproduciendo: " + name);
}
function stopHere(){
  var v = $("v");
  try{
    if(hereCtx && v.currentTime > 0){ recordProg(hereCtx, v.currentTime, v.duration); saveProg(true); }
    v.onpause = null; v.ontimeupdate = null; v.onended = null; v.pause();
    killHls();
  }catch(e){}
  hereCtx = null;
}
function copyText(t){
