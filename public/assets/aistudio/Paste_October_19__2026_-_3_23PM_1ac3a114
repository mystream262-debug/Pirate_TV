/* lista COMPLETA (todas las categorias) sin los enlaces ya depurados. cb(null) si falla */
function loadFull(m, cb){
  catNames(m, function(cm){
    apiTry(A[m].list, "", function(d){
      var out = [], i, o;
      if(!(d instanceof Array)) d = [];
