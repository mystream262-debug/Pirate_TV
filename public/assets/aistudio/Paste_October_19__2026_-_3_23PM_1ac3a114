      if(d.length > 30 && !confirm("Las series se exportan episodio por episodio: hay que pedirle al servidor los episodios de " + d.length + " series.\n\nPuede tardar varios minutos. \u00bfContinuar?")){ cb(null); return; }
      var jobs = [], res = [], fail = 0;
      for(i=0;i<d.length;i++) jobs.push({ s:d[i], i:i });
      runPool(jobs, 5, function(job, next){
        var s = job.s;
        apiTry("get_series_info", "&series_id=" + s.series_id, function(inf){
          var eps = (inf && inf.episodes && !(inf.episodes instanceof Array)) ? inf.episodes : {}, sn, list, j, e, tmp = [], r = [];
          for(sn in eps){
            if(!eps.hasOwnProperty(sn)) continue;
            list = eps[sn] || [];
            for(j=0;j<list.length;j++) tmp.push({ s:parseInt(sn,10) || 0, n:parseInt(list[j].episode_num,10) || 0, e:list[j] });
          }
          tmp.sort(function(a,b){ return (a.s - b.s) || (a.n - b.n); });
          for(j=0;j<tmp.length;j++){
            e = tmp[j].e;
            r.push({ id:e.id, name:s.name + " - T" + tmp[j].s + " E" + tmp[j].n + (V(e.title) ? " - " + V(e.title) : ""), logo:V(s.cover), group:cm[s.category_id] || "", epg:"",
                     url:base + "/series/" + user + "/" + pass + "/" + e.id + "." + (V(e.container_extension) || "mp4") });
          }
          res[job.i] = r; next();
        }, function(){ fail++; next(); });
      }, function(f, t){ if(f % 10 == 0 || f == t) st("Series: leyendo episodios " + f + " / " + t); },
      function(){
        for(var q=0;q<res.length;q++){ if(res[q]) out = out.concat(res[q]); }
        if(fail) st("Aviso: " + fail + " series no respondieron y quedaron fuera.");
        cb(out);
      });
    }, function(msg){ st("Error de conexi\u00f3n con el servidor (" + msg + ")"); cb(null); });
  });
}

