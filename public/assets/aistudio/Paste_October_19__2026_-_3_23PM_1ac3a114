<body>

<div id="login">
  <div id="lbox">
    <img id="lLogo" alt="Pirate_TV">
    <input class="linp" id="l_usr" type="text" placeholder="Usuario" onkeydown="if(event.keyCode==13){ enterUsr(); }">
    <input class="linp" id="l_pwd" type="password" placeholder="Contrase&ntilde;a" onkeydown="if(event.keyCode==13){ doLogin(); }">
    <button class="lgo" id="lBtn" onclick="doLogin()">ENTRAR</button>
    <div id="lmsg"></div>
  </div>
  <button class="gearb" id="lgear" onclick="askCfg()" title="Ajustes">&#9881;</button>
</div>

<div id="app">
  <div id="bar">
    <div class="brand" onclick="goHome()" title="Inicio"><img id="bLogo" alt=""><span class="bname">Pirate_TV</span></div>
    <button class="nb" id="bBack" onclick="goHome()" style="display:none">&#9664; Inicio</button>
    <span id="bTitle"></span>
    <span class="sp"></span>
    <input class="inp" id="q" type="text" placeholder="Buscar en TV, pel&iacute;culas y series..." onkeyup="onSearchKey(event)" oninput="onSearchKey(event)">
    <button class="nb" id="bCat" onclick="toggleSide()" style="display:none">&#9776; Categor&iacute;as</button>
    <button class="nb ic" onclick="askCfg()" title="Ajustes">&#9881;</button>
    <button class="nb" onclick="doLogout()" title="Cerrar sesi&oacute;n">Salir</button>
  </div>

  <div id="home">
    <div id="tiles">
      <div class="tile" onclick="openSection('live')"><img id="tLive" alt="TV en vivo"></div>
      <div class="tile" onclick="openSection('vod')"><img id="tVod" alt="Pel&iacute;culas"></div>
      <div class="tile" onclick="openSection('series')"><img id="tSeries" alt="Series"></div>
    </div>
  </div>

  <div id="secWrap">
    <div id="sideBg" onclick="toggleSide()"></div>
    <div id="side"></div>
    <div id="content" onscroll="onScroll()">
      <div id="hero" class="heroSp"></div>
      <div id="cont"></div>
      <div class="secT" id="secT"></div>
      <div class="grid" id="grid"></div>
      <div class="msg" id="msg"></div>
    </div>
  </div>

  <div id="sres"></div>

  <div id="status">Listo.</div>
</div>

<div id="modal">
  <button id="mclose" onclick="closeDetail()">&#10005;</button>
  <div id="mbox">
    <div id="vbox"><video id="v" controls></video></div>
    <div id="mBody"></div>
  </div>
</div>

<div id="intro"><video id="introV" preload="auto"></video></div>

<div id="pw">
  <div id="pwbox">
    <h2>Ajustes</h2>
    <div class="small">Escribe la contrase&ntilde;a para continuar.</div>
    <input class="linp" id="pw_in" type="password" style="margin-top:14px" onkeydown="if(event.keyCode==13){ checkPw(); }">
    <div id="pw_msg"></div>
    <button class="btn" onclick="checkPw()">Aceptar</button>
    <button class="btn g" onclick="closePw()">Cancelar</button>
  </div>
</div>

<div id="cfg">
  <div id="cfgbox">
    <h2>Ajustes</h2>
    <div class="warn" id="cfgWarn"></div>
    <div class="fr"><label>Servidor</label><input class="inp" id="c_srv" type="text"></div>
    <div class="fr"><label>Reproductor externo (VLC recomendado; tambi&eacute;n sirve MPC-HC, PotPlayer o mpv)</label>
