/* texto UTF-8 sin BOM (lo correcto para .m3u8) */
function writeUtf8(path, text){
  var a = new ActiveXObject("ADODB.Stream"), b = new ActiveXObject("ADODB.Stream");
  a.Type = 2; a.Charset = "utf-8"; a.Open(); a.WriteText(text);
  a.Position = 0; a.Type = 1; a.Position = 3;
  b.Type = 1; b.Open(); a.CopyTo(b); b.SaveToFile(path, 2);
  b.Close(); a.Close();
}

function apiTry(action, extra, ok, bad){
  var u = base + "/player_api.php?username=" + encodeURIComponent(user) + "&password=" + encodeURIComponent(pass);
  if(action) u += "&action=" + action;
  if(extra) u += extra;
  http(u, function(t){
    var d; try{ d = JSON.parse(t); }catch(e){ if(bad) bad("respuesta inv\u00e1lida"); return; }
    ok(d);
  }, function(m){ if(bad) bad(m); });
}

/* reparte la lista en N "carriles" que corren a la vez */
function runPool(items, n, worker, tick, done){
  var P = { n:n, stop:false }, i = 0, active = 0, fin = 0, total = items.length, over = false;
  function pump(){
    while(!P.stop && active < P.n && i < total){
      active++;
      (function(it){
        var once = false;
        worker(it, function(){ if(once) return; once = true; active--; fin++; tick(fin, total); pump(); });
      })(items[i++]);
    }
    if(active == 0 && (P.stop || i >= total) && !over){ over = true; done(fin, total); }
  }
  setTimeout(pump, 0);
  return P;
}

