/* ---------- VLC portable: se descarga y descomprime junto al programa (todo nativo) ---------- */
var vlcBusy = false;
function portableVlc(){
  try{
    var root = appFolder(), e, e2, s, p;
    if(!fso.FolderExists(root)) return "";
    for(e = new Enumerator(fso.GetFolder(root).SubFolders); !e.atEnd(); e.moveNext()){
      s = e.item();
      if(!/^vlc/i.test(s.Name)) continue;
      p = s.Path + "\\vlc.exe"; if(fso.FileExists(p)) return p;
      for(e2 = new Enumerator(s.SubFolders); !e2.atEnd(); e2.moveNext()){
        p = e2.item().Path + "\\vlc.exe"; if(fso.FileExists(p)) return p;
      }
    }
  }catch(x){}
  return "";
}
function vlcMsg(t){ $("cfgWarn").innerHTML = t; $("cfgWarn").style.display = "block"; st(t.replace(/<[^>]*>/g, " ")); }
function vlcFail(msg){
  vlcBusy = false;
  vlcMsg(msg + "<br>Plan B: descarga el .zip de VLC desde videolan.org, extr\u00e1elo dentro de una carpeta llamada <b>vlc</b> junto a este programa y vuelve a abrirlo.");
}
function installVlc(){
  if(vlcBusy) return;
  var have = portableVlc();
  if(have){ cfg.vlc = have; saveCfg(); $("c_vlc").value = have; vlcMsg("Ya hay un VLC junto al programa: " + have); return; }
  vlcBusy = true;
  var arch = sh.ExpandEnvironmentStrings("%PROCESSOR_ARCHITEW6432%");
  if(arch.charAt(0) == "%") arch = sh.ExpandEnvironmentStrings("%PROCESSOR_ARCHITECTURE%");
  var dir = /64/.test(arch) ? "win64" : "win32";
  vlcMsg("Buscando la \u00faltima versi\u00f3n de VLC...");
  http("https://get.videolan.org/vlc/", function(t){
    var vs = [], seen = {}, m, re = /href="(?:[^"]*\/)?(3\.\d+\.\d+)\/?"/g;
    while((m = re.exec(t)) !== null){ if(!seen[m[1]]){ seen[m[1]] = 1; vs.push(m[1]); } }
    vs.sort(function(a,b){ var x = a.split("."), y = b.split("."), i, d; for(i=0;i<3;i++){ d = parseInt(x[i],10) - parseInt(y[i],10); if(d) return d; } return 0; });
    vs.reverse();
    if(!vs.length) vs.push("3.0.21");
    tryVlcVer(vs, 0, dir);
  }, function(){ tryVlcVer(["3.0.21"], 0, dir); });
}
function tryVlcVer(vs, i, dir){
  if(i >= vs.length || i >= 4){ vlcFail("No encontr\u00e9 el .zip de VLC en el servidor."); return; }
  var v = vs[i], url = "https://get.videolan.org/vlc/" + v + "/" + dir + "/";
  http(url, function(t){
    var m = t.match(new RegExp('href="(?:[^"]*/)?(vlc-' + v.replace(/\./g, "\\.") + '-' + dir + '\\.zip)"'));
    if(m) downloadVlc(url + m[1], v, m[1]); else tryVlcVer(vs, i + 1, dir);
  }, function(){ tryVlcVer(vs, i + 1, dir); });
}
function downloadVlc(url, v, fname){
  var root = appFolder(), zip = root + "\\" + fname, x;
  vlcMsg("Descargando VLC " + v + " (unos 40 MB). No cierres el programa...");
  try{ x = new ActiveXObject("MSXML2.XMLHTTP.6.0"); x.open("GET", url, true); }
  catch(e){ vlcFail("No pude iniciar la descarga: " + e.message); return; }
  x.onreadystatechange = function(){
    if(x.readyState != 4) return;
    var s = 0; try{ s = x.status; }catch(e){}
    if(s != 200){ vlcFail("La descarga fall\u00f3 (HTTP " + s + ")."); return; }
    try{
      var b = new ActiveXObject("ADODB.Stream"); b.Type = 1; b.Open(); b.Write(x.responseBody); b.SaveToFile(zip, 2); b.Close();
    }catch(e){ vlcFail("No pude guardar el archivo: " + e.message); return; }
    unzipVlc(zip, root + "\\vlc");
  };
  try{ x.send(); }catch(e){ vlcFail("No pude descargar: " + e.message); }
}
function unzipVlc(zip, dest){
  vlcMsg("Descomprimiendo VLC...");
  try{
    if(!fso.FolderExists(dest)) fso.CreateFolder(dest);
    var sa = new ActiveXObject("Shell.Application");
    sa.NameSpace(dest).CopyHere(sa.NameSpace(zip).Items(), 4 + 16 + 1024);
  }catch(e){ vlcFail("No pude descomprimir: " + e.message); return; }
  var last = -1, same = 0, ticks = 0;
  var tmr = setInterval(function(){
    var size = 0, ok = portableVlc();
    ticks++;
    try{ size = fso.GetFolder(dest).Size; }catch(e){}
    if(ok && size > 0 && size == last) same++; else same = 0;
    last = size;
    if(same >= 2){
      clearInterval(tmr); vlcBusy = false;
      try{ fso.DeleteFile(zip); }catch(e){}
      cfg.vlc = ok; saveCfg(); $("c_vlc").value = ok;
      vlcMsg("VLC instalado junto al programa. Cierra Ajustes y ya puedes reproducir.");
    } else if(ticks > 240){ clearInterval(tmr); vlcFail("La descompresi\u00f3n tard\u00f3 demasiado."); }
  }, 2500);
}

